# Supabase PostgreSQL
# Use the Supabase connection string. Hosted Postgres requires SSL.
DATABASE_URL=postgresql://postgres:YOUR_SUPABASE_PASSWORD@YOUR_SUPABASE_HOST:5432/postgres?sslmode=require

# Flask and JWT
# Generate unique production values with: python -c "import secrets; print(secrets.token_urlsafe(48))"
